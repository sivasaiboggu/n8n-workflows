        "channel": "YOUR_SLACK_CHANNEL_ID",
        "text": "=Competitor Spy Bot FAILED: {{ $json.error }} (execution {{ $json.execution_id }})",
        "otherOptions": {}
      },
      "id": "5678311e-a04a-43fb-8882-a2f485756bf8",
      "name": "Notify on Error (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        480,
        700
      ]
    }
