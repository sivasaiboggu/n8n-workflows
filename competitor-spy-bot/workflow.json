      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "YOUR_EXECUTION_LOG_SHEET_ID",
        "sheetName": "Log",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $now.toISO() }}",
            "workflow": "Competitor Spy Bot",
            "status": "={{ $json.status || 'done' }}",
            "detail": "={{ $json.output || $json.reason || '' }}"
          }
        }
      },
      "id": "645c0316-50d1-4de0-b1f6-204b5580c44d",
      "name": "Log Execution",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        3600,
        180
      ]
    },
    {
      "parameters": {},
      "id": "5f5a8623-e623-4ff4-90ce-6d3dd2de704c",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        700
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": "YOUR_ERROR_LOG_SHEET_ID",
        "sheetName": "Errors",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $now.toISO() }}",
            "workflow": "={{ $json.workflow?.name }}",
            "node": "={{ $json.execution?.lastNodeExecuted }}",
            "error": "={{ $json.execution?.error }}",
            "execution_id": "={{ $json.execution?.id }}"
          }
        }
      },
      "id": "7493850b-213f-4e16-8549-82f25729a4bd",
      "name": "Log Error to Sheet",
