    {
      "parameters": {
        "options": {
          "systemMessage": "Parse Siva's plain-text habit reply into ONLY valid JSON: {mood (1-10 or null), sleepHours (number or null), workedOut (true/false/null), note (short string)}. Never invent values \u2014 use null when he did not say. No medical interpretation."
        },
        "promptType": "define"
      },
      "id": "48c7bd89-ab89-4537-9e16-7bc849876cca",
      "name": "Gemini Parse Reply",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        240,
        600
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "Date": "={{ $now.toISO() }}",
            "Mood": "={{ $json.mood }}",
            "Sleep Hours": "={{ $json.sleepHours }}",
            "Worked Out": "={{ $json.workedOut }}",
            "Note": "={{ $json.note }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Check-ins"
      },
      "id": "c6cd8c54-4310-4d12-9864-8dc889eb36c9",
      "name": "Store Check-in",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        480,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "// Slip = mood <= 4 twice in a row, OR sleep < 6h for 2+ days, OR no workout 3+ days.\n// Reads the Check-ins rows passed in; outputs slip=true/false with a reason.\nconst rows = $input.all().map(i => i.json);\nconst last = rows.slice(-3);\nconst lowMood = last.filter(r => Number(r.Mood) > 0 && Number(r.Mood) <= 4).length >= 2;\nconst lowSleep = last.filter(r => Number(r['Sleep Hours']) > 0 && Number(r['Sleep Hours']) < 6).length >= 2;\nconst noWorkout = last.filter(r => String(r['Worked Out']).toLowerCase() === 'false').length >= 3;\nconst slip = lowMood || lowSleep || noWorkout;\nreturn [{ json: { slip, reason: lowMood ? 'low mood 2 days' : lowSleep ? 'short sleep 2 days' : noWorkout ? 'no workout 3 days' : 'on track' } }];"
      },
      "id": "e7d3baad-ab02-44fb-bca1-5d5a15b819b6",
      "name": "Detect Slipping Pattern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        600
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fefe6f50-c036-483a-b510-49ee133d2091",
              "leftValue": "={{ $json.slip }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.string.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      },
      "id": "65e84576-d04b-4cfd-913c-b945b0032346",
      "name": "Pattern Slipping?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        600
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "+919573719115",
        "message": "=Hey Siva \u2014 noticed {{ $json.reason }} lately. Small step today: a 10-min walk or an early night? No pressure, just checking in. (General wellness nudge, not medical advice.)",
        "messageType": "text"
