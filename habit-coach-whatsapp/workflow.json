      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are Siva's friendly habit coach. Siva is Sivasai Boggu, a final-year BTech CS student and Whispry intern. Using his recent habit rows (mood, sleep hours, workouts, streaks), write ONE short warm WhatsApp check-in (under 60 words) asking how he slept, his mood 1-10, and whether he worked out. Encouraging, never shaming. No medical claims, no diagnosis, no treatment advice \u2014 general wellness only."
        },
        "promptType": "define"
      },
      "id": "0aedd264-6011-4e8b-8ce5-edcbb45cd060",
      "name": "Gemini Coach \u2014 Write Check-in",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        480,
        240
      ]
    },
    {
