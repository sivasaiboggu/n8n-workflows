          },
          "matchingColumns": [
            "timestamp",
            "workflow",
            "status",
            "summary"
          ],
          "schema": []
        }
      },
      "id": "301f1592-91b6-5ea8-85ad-f6f8ca8bbd29",
      "name": "Log Execution",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        2640,
        120
      ]
    },
    {
      "parameters": {},
