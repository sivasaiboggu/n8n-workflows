    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=\u26a0\ufe0f n8n error in {{ $json.workflow?.name }}: {{ $json.error?.message }}. Logged to sheet."
      },
      "id": "f71beb49-7acc-5e51-99e8-f823e2e7b478",
      "name": "Notify Siva \u2014 Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        560
      ]
    },
    {
      "parameters": {
        "content": "AI Customer Support Triage \u2014 Siva\nWebhook/form message \u2192 RAG context (placeholder) \u2192 Gemini triages. Confident (\u22650.8) \u2192 draft reply \u2192 HUMAN APPROVAL (Telegram + Approval sheet) \u2192 Gmail reply. Not confident \u2192 ticket in Linear/Jira + Telegram alert. Nothing customer-facing is sent without approval.",
        "height": 180,
        "width": 420
      },
      "id": "f65707a1-0df2-55e0-b033-50afc60af4cd",
      "name": "Sticky Note \u2014 Flow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -320
      ]
    },
    {
      "parameters": {
        "content": "MEMORY: no live vector DB is connected. 'Retrieve Docs Context' is a placeholder that returns empty context until a vector store is wired in. Store per run: message, matched doc ids, answer, confidence, resolved? \u2014 in the Support Log sheet tab. Never let the agent answer from invented docs.",
        "height": 180,
        "width": 420
      },
      "id": "b431823c-227f-5dde-a61c-aad840e66eea",
      "name": "Sticky Note \u2014 Memory Layer",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        480,
        -320
      ]
    },
    {
      "parameters": {
        "content": "CREDENTIALS NEEDED (pick/create on import \u2014 no credential is set in this file):\n\u2022 Gemini Chat Model \u2192 Google Gemini API\n\u2022 Send Customer Reply \u2192 Gmail account (sivasaiboggu@gmail.com)\n\u2022 Send Approval Request / Notify Support Team / Notify Siva \u2014 Error \u2192 Telegram account\n\u2022 Read Approval Sheet / Log Execution / Log Error to Sheet \u2192 Google Sheets account\n\u2022 Create Ticket \u2192 Linear API Token (HTTP Header Auth)\nSee SETUP.md \u00a72 for how to create each one.",
        "height": 260,
        "width": 420
      },
      "id": "8eaaa44e-5602-58c4-bc7e-5679c609f731",
