{
  "name": "Image-to-Product-Listing \u2014 Siva",
  "nodes": [
    {
      "parameters": {
        "content": "Photo upload webhook -> Gemini vision identifies the item and writes title, description, tags + a suggested price -> HUMAN APPROVAL (Listing Approvals sheet) -> only then cross-post to Shopify, eBay and Etsy. No listing ever goes live without Siva marking APPROVED. Prices are suggestions, not promises.\nCredentials to set on import (nodes show 'No credential set'): Google Gemini API (chat model); Google Sheets OAuth2 (all Sheets nodes); Telegram (approval + error notify); Shopify (Create Shopify Product); eBay API Token via Header Auth (Cross-post to eBay); Etsy API Key via Header Auth (Cross-post to Etsy).",
        "height": 120,
        "width": 420
      },
      "id": "52021c48-7970-45e1-be6a-6737d8a1b044",
      "name": "Sticky Note \u2014 How this works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ]
    },
    {
      "parameters": {},
      "id": "0d33e18a-f2ce-4a29-b208-61b632686d18",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "product-photo",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "f6be059e-f125-4143-8c20-50ec573d8f9b",
      "name": "Webhook \u2014 Photo Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are a product-listing assistant. Look at the uploaded product photo and return ONLY valid JSON: {title (under 80 chars), description (2-3 sentences, honest, no hype), tags (array of up to 10), suggestedPrice (number), currency ('INR'), condition ('new'|'used'|'refurbished'|null), category}. Describe only what you can see \u2014 never invent brand, model, or defects. If the photo is unclear, say so in the description and set suggestedPrice to null."
        },
        "promptType": "define"
      },
      "id": "f5ea6508-df10-4b6c-91c5-ba0caac4e4b5",
      "name": "Gemini Vision Identify Item",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash",
        "options": {}
      },
      "id": "956d69b9-cfd9-4519-9928-faf69354c881",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise the Gemini vision output into a listing draft; keep price a suggestion.\nconst j = $input.first().json;\nconst d = typeof j.output === 'string' ? JSON.parse(j.output) : (j.output || j);\nreturn [{ json: { title: d.title || 'Untitled item', description: d.description || '',\n  tags: Array.isArray(d.tags) ? d.tags.join(', ') : (d.tags || ''),\n  suggestedPrice: d.suggestedPrice ?? null, currency: d.currency || 'INR',\n  condition: d.condition || null, category: d.category || 'Other',\n  draftedAt: new Date().toISOString() } }];"
      },
      "id": "d7e64d83-3b3f-4a38-825b-fabcd74ffe44",
      "name": "Write Listing Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "Title": "={{ $json.title }}",
            "Description": "={{ $json.description }}",
            "Tags": "={{ $json.tags }}",
            "Suggested Price": "={{ $json.suggestedPrice }}",
            "Currency": "={{ $json.currency }}",
            "Condition": "={{ $json.condition }}",
            "Category": "={{ $json.category }}",
            "Status": "PENDING",
            "Queued At": "={{ $now.toISO() }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Listing Approvals"
      },
      "id": "ff39a3bb-e54b-4a55-93a4-c70c847eabd9",
      "name": "Queue Listing for Approval",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "operation": "sendMessage",
        "text": "=New product listing draft:\n{{ $json.Title }}\n{{ $json.Description }}\nSuggested price: {{ $json.Currency }} {{ $json['Suggested Price'] }} ({{ $json.Condition }}, {{ $json.Category }})\nTags: {{ $json.Tags }}\nMark APPROVED in the Listing Approvals sheet to publish to Shopify, eBay and Etsy. Nothing goes live before that."
      },
      "id": "6abcac4e-d0ff-4677-ac6c-42e9cb2ff070",
      "name": "Request Approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "hours",
        "resume": "afterTimeInterval"
      },
      "id": "03b0a7de-1346-410d-9978-27e2856136ff",
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1200,
        240
      ]
    },
    {
      "parameters": {
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "read",
        "options": {},
        "resource": "sheet",
        "sheetName": "Listing Approvals"
      },
      "id": "12d85e15-0fdb-44f1-bdff-cc819226b4f0",
      "name": "Read Approval Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1440,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "8c67e8ed-bf7c-42db-b016-117acf0f77e6",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "APPROVED",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.string.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      },
      "id": "c58dfb88-48ea-44c1-b84a-29117618f051",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "resource": "product",
        "title": "={{ $json.Title }}",
        "additionalFields": {
          "body_html": "={{ $json.Description }}",
          "tags": "={{ $json.Tags }}",
          "variants": [
            {
              "price": "={{ $json['Suggested Price'] }}"
            }
          ]
        }
      },
      "id": "95bcd58b-be98-448f-8bb7-b8e0c7269dad",
      "name": "Create Shopify Product",
      "type": "n8n-nodes-base.shopify",
      "typeVersion": 1,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ebay.com/sell/inventory/v1/inventory_item",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        },
        "sendHeaders": true,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"title\": \"{{ $json.Title }}\", \"description\": \"{{ $json.Description }}\", \"price\": {{ $json['Suggested Price'] }}, \"currency\": \"{{ $json.Currency }}\"}"
      },
      "id": "8963a62d-91b3-48e8-9e2a-a4d803d0551a",
      "name": "Cross-post to eBay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openapi.etsy.com/v3/application/shops/YOUR_SHOP_ID/listings",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        },
        "sendHeaders": true,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"title\": \"{{ $json.Title }}\", \"description\": \"{{ $json.Description }}\", \"price\": {{ $json['Suggested Price'] }}, \"quantity\": 1}"
      },
      "id": "d7365099-a684-4c8a-8063-888c2055f9d7",
      "name": "Cross-post to Etsy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "Title": "={{ $json.Title }}",
            "Suggested Price": "={{ $json['Suggested Price'] }}",
            "Status": "DECLINED",
            "Logged At": "={{ $now.toISO() }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Declined"
      },
      "id": "e3f966fe-3e8b-4e6c-ae7b-70fa8c2e9eac",
      "name": "Log Declined",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1920,
        480
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "At": "={{ $now.toISO() }}",
            "Workflow": "Image-to-Product-Listing",
            "Result": "={{ $json.Status || 'listed' }}",
            "Detail": "={{ $json.Title || '' }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Execution Log"
      },
      "id": "be74b7cf-2155-4681-b74c-3c968ac753b8",
      "name": "Log Execution",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        2640,
        0
      ]
    },
    {
      "parameters": {},
      "id": "94290069-7a14-44f7-bea3-e3883a0f775a",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        720
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "At": "={{ $now.toISO() }}",
            "Error": "={{ $json.error?.message || JSON.stringify($json.error || $json) }}",
            "Node": "={{ $json.execution?.lastNodeExecuted || $json.node || 'unknown' }}",
            "Workflow": "={{ $json.workflow?.name || 'unknown' }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Errors"
      },
      "id": "f491b4e6-cc8c-42aa-b3b7-c82c492f7613",
      "name": "Log Error to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        240,
        720
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "operation": "sendMessage",
        "text": "=n8n workflow error. Check the Errors sheet.\nNode: {{ $json.execution?.lastNodeExecuted || 'unknown' }}\nError: {{ $json.error?.message || 'see Errors sheet' }}"
      },
      "id": "3a90d065-c8a6-415a-a5b3-b2189e16d42e",
      "name": "Notify Error via Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        720
      ]
    }
  ],
