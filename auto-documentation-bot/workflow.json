{
  "name": "Auto-Documentation Bot \u2014 Siva",
  "nodes": [
    {
      "parameters": {
        "content": "GitHub push / PR merged -> fetch the diff -> Gemini writes README + changelog drafts -> HUMAN APPROVAL (Doc Approvals sheet) -> only then update docs on GitHub, post release notes to Slack and create a Notion page. No public post without Siva marking APPROVED.\nCredentials to set on import (nodes show 'No credential set'): GitHub (trigger + file update); GitHub Personal Access Token via Header Auth (Get Commit Diff); Google Gemini API (chat model); Google Sheets OAuth2 (all Sheets nodes); Telegram (approval + error notify); Slack (release notes); Notion (release page).",
        "height": 120,
        "width": 420
      },
      "id": "da6e1eb9-9f0a-4e73-ab52-321849b10c9b",
      "name": "Sticky Note \u2014 How this works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ]
    },
    {
      "parameters": {},
      "id": "a477327b-7a3e-41a7-9ecd-2bb47aa665ec",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "events": [
          "push",
          "pull_request"
        ]
      },
      "id": "65e0b59a-48e4-4f2f-a489-2183303a58f4",
      "name": "GitHub Trigger \u2014 Push / PR Merged",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/YOUR_GITHUB_USERNAME/YOUR_REPO/compare/{{ $json.before }}...{{ $json.after }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        },
        "sendHeaders": true
      },
      "id": "fd7cf128-5037-43ce-9e75-befe8cd100d4",
      "name": "Get Commit Diff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are Siva's documentation bot. Siva is Sivasai Boggu (AI SDR agent, Voice Receptionist, HireMind, SecureFlow, AuditMind repos). Read the GitHub diff and write: (1) a concise README update section, (2) a changelog entry (Added/Changed/Fixed), (3) short release notes. Accurate to the diff only \u2014 never invent features. Return markdown."
        },
        "promptType": "define"
      },
      "id": "0097313c-a70f-456f-9b17-168908374188",
      "name": "Gemini Read Diff",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash",
        "options": {}
      },
      "id": "deff6cba-9204-40a3-b908-e30938412bc7",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        480,
        480
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0904e0dc-5f9f-4edd-b580-b545ca820efc",
              "name": "releaseNotes",
              "type": "string",
              "value": "={{ $json.output }}"
            },
            {
              "id": "68f3333e-18a6-44b6-8d6c-74ab42abfbf8",
              "name": "repo",
              "type": "string",
              "value": "={{ $json.repository?.full_name || 'YOUR_REPO' }}"
            },
            {
              "id": "1e0eb54e-a3e2-4f30-a38c-3acd1f7ffda4",
              "name": "commit",
              "type": "string",
              "value": "={{ $json.after || $json.head_commit?.id || '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "79dd984e-9743-44f9-9980-b9d27a0a296b",
      "name": "Draft Release Notes",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "Repo": "={{ $json.repo }}",
            "Commit": "={{ $json.commit }}",
            "Release Notes": "={{ $json.releaseNotes }}",
            "Status": "PENDING",
            "Queued At": "={{ $now.toISO() }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Doc Approvals"
      },
      "id": "1ec57548-8b8f-424c-8ff5-7caa36b426d0",
      "name": "Queue Docs for Approval",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "operation": "sendMessage",
        "text": "=Docs draft ready for {{ $json.Repo }} ({{ $json.Commit }}).\n{{ $json['Release Notes'] }}\nMark APPROVED in the Doc Approvals sheet to publish to GitHub, Slack and Notion."
      },
      "id": "244ffeef-b92e-4c8d-8bf4-cc89afbf6a4b",
      "name": "Request Approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        240
      ]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "hours",
        "resume": "afterTimeInterval"
      },
      "id": "0082503d-4a38-45e4-ab9e-0552a02e4960",
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1440,
        240
      ]
    },
    {
      "parameters": {
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "read",
        "options": {},
        "resource": "sheet",
        "sheetName": "Doc Approvals"
      },
      "id": "c37af66b-00d9-42f7-b496-67eccd5651ee",
      "name": "Read Approval Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "8f2e206d-c151-4e38-a64e-c6e3ff309c58",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "APPROVED",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.string.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      },
      "id": "be160c16-b1ec-4e32-ba26-9667e5c68dc1",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        240
      ]
    },
    {
      "parameters": {
        "operation": "edit",
        "resource": "file",
        "filePath": "CHANGELOG.md",
        "fileContent": "={{ $json['Release Notes'] }}",
        "owner": "YOUR_GITHUB_USERNAME",
        "repository": "YOUR_REPO"
      },
      "id": "abab0054-d5d5-4732-9529-f9aca32b1174",
      "name": "Update README / Changelog",
      "type": "n8n-nodes-base.github",
      "typeVersion": 2,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "channel": "#general",
        "operation": "postMessage",
        "text": "=Release notes \u2014 {{ $json.Repo }}\n{{ $json['Release Notes'] }}",
        "otherOptions": {}
      },
      "id": "796deeab-4d40-4e45-aa4c-06a737dd3ca3",
      "name": "Post Release Notes to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "resource": "page",
        "pageId": {
          "__rl": true,
          "value": "YOUR_NOTION_PARENT_PAGE_ID",
          "mode": "url"
        },
        "title": "=Release notes \u2014 {{ $json.Repo }}",
        "options": {}
      },
      "id": "396b6a64-ce5e-4546-a083-2246bade7c2f",
      "name": "Create Notion Release Page",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        2640,
        0
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "Repo": "={{ $json.Repo }}",
            "Commit": "={{ $json.Commit }}",
            "Status": "DECLINED",
            "Logged At": "={{ $now.toISO() }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Declined"
      },
      "id": "d9396cd1-8cf3-4122-893c-e14e17c69342",
      "name": "Log Declined",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        2160,
        480
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "At": "={{ $now.toISO() }}",
            "Workflow": "Auto-Documentation Bot",
            "Result": "={{ $json.Status || 'published' }}",
            "Detail": "={{ $json.Repo || '' }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Execution Log"
      },
      "id": "e047a098-a82f-455b-870b-a50e240f8a6e",
      "name": "Log Execution",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        2880,
        0
      ]
    },
    {
      "parameters": {},
      "id": "e632686f-be50-479e-9c47-2ca1a5980f62",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        720
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "At": "={{ $now.toISO() }}",
            "Error": "={{ $json.error?.message || JSON.stringify($json.error || $json) }}",
            "Node": "={{ $json.execution?.lastNodeExecuted || $json.node || 'unknown' }}",
            "Workflow": "={{ $json.workflow?.name || 'unknown' }}"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Errors"
      },
      "id": "35191dac-9290-4d2e-83a5-27e1a4811fd8",
      "name": "Log Error to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        240,
        720
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "operation": "sendMessage",
        "text": "=n8n workflow error. Check the Errors sheet.\nNode: {{ $json.execution?.lastNodeExecuted || 'unknown' }}\nError: {{ $json.error?.message || 'see Errors sheet' }}"
      },
      "id": "762a76c7-e37e-431e-8657-0743a20d8a72",
      "name": "Notify Error via Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        720
      ]
    }
  ],
