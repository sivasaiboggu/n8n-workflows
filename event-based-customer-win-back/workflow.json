{
 "name": "Event-Based Customer Win-Back — Siva",
 "nodes": [
  {
   "parameters": {
    "content": "CREDENTIALS NEEDED (pick/create on import — no credential is set in this file):\nn8n shows \"No credential set\" on each node below; click the node and pick/create the credential. No key or secret is stored in this file.\n- Google Sheets account (googleSheetsOAuth2) — Read Customer Signals, Save Draft Win-Back Message, Check Approval Sheet, Check for Reply, Log Win-Back Outcome, Log Not Sent — Awaiting Approval, Log Execution, Log Error to Sheet\n- Google Gemini(PaLM) Api (googlePalmApi) — Gemini Chat Model\n- Telegram account (telegramApi) — Send Approval Request via Telegram, Escalate to Human — No Reply, Notify Error via Telegram\n- Gmail account (gmailOAuth2) — Send Win-Back Email\n- SMS Provider API (httpHeaderAuth) — Send Win-Back SMS",
    "height": 242,
    "width": 560,
    "color": 4
   },
   "id": "f68daa14-3131-4c6b-91df-060b88331d12",
   "name": "Sticky Note — Credentials",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -522
   ]
  },
  {
   "parameters": {
    "content": "Event-Based Customer Win-Back — Siva\nDetect churn signals (inactivity, failed payments, support complaints) from Sheets/CRM. Gemini writes a personalised win-back message.\nSends ONLY after human approval. Tracks replies; escalates to a human if no reply in 3 days.",
    "height": 140,
    "width": 560,
    "color": 4
   },
   "id": "0b9dd2c5-d70c-4d04-b6b3-fab8d3d977b6",
   "name": "About This Workflow",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -260
   ]
  },
  {
   "parameters": {
    "httpMethod": "POST",
    "path": "YOUR_WINBACK_WEBHOOK_PATH",
    "responseMode": "onReceived",
    "options": {}
   },
   "id": "7f976f7e-bec8-42b9-9bcd-e2c0ec25c44a",
   "name": "Churn Signal Webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "hours",
       "hoursInterval": 24
      }
     ]
    }
   },
   "id": "ab2f5125-0180-4f05-8d24-aa8dea989dc7",
   "name": "Daily Churn Check",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    200
   ]
  },
  {
   "parameters": {
    "documentId": "YOUR_GOOGLE_SHEET_ID",
    "sheetName": "Customer Signals",
    "operation": "read"
   },
   "id": "eb35ee28-77e3-45bc-886d-7b8221faaee2",
   "name": "Read Customer Signals",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4,
   "position": [
    240,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "// Keep customers with a churn signal: inactive > 30 days, failed payment, or a support complaint.\nreturn $input.all().filter(i => { const j = i.json; return Number(j.days_inactive || 0) > 30 || String(j.payment_status || '').toLowerCase() === 'failed' || String(j.support_complaint || '').toLowerCase() === 'yes'; });"
   },
   "id": "1059656c-507e-4621-b896-c9d189bc270c",
   "name": "Detect Churn Signals",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    480,
    0
   ]
  },
  {
   "parameters": {
    "promptType": "text",
    "text": "=Write a short, personalised win-back message for the customer in the input. Use their name, product, and the specific churn signal (inactivity / failed payment / complaint — acknowledge a complaint, never argue). Offer one concrete next step, no discount you were not told to offer. Keep it under 120 words, warm and human. Output the message only. Input: {{ JSON.stringify($json).slice(0, 3000) }}",
    "options": {}
   },
   "id": "f3f5acec-e943-4e05-84f4-f44daca85af8",
   "name": "Win-Back Writer",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 1.7,
   "position": [
    720,
    0
   ]
  },
  {
   "parameters": {
    "model": "gemini-2.0-flash",
    "options": {
     "temperature": 0.3
    }
   },
   "id": "81f2c012-9a9f-45df-ab31-ec5461637d86",
   "name": "Gemini Chat Model",
   "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
   "typeVersion": 1,
   "position": [
    720,
    280
   ]
  },
  {
   "parameters": {
    "documentId": "YOUR_GOOGLE_SHEET_ID",
    "sheetName": "Win-Back Drafts",
    "operation": "append",
    "columns": {
     "mappingMode": "manual",
     "value": {
      "timestamp": "={{ $now }}",
      "customer_name": "={{ $json.customer_name || '' }}",
      "email": "={{ $json.email || '' }}",
      "message": "={{ $json.output || '' }}",
      "status": "draft — awaiting approval"
     }
    }
   },
   "id": "0b4735f6-5400-4318-ba1c-f6168bff3eab",
   "name": "Save Draft Win-Back Message",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4,
   "position": [
    960,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "YOUR_TELEGRAM_CHAT_ID",
    "text": "=📩 Win-back draft ready for {{ $json.customer_name || 'a customer' }} ({{ $json.email || '' }}).\n\n{{ $json.output || '' }}\n\nWrite APPROVE in the Approval tab to send it. Nothing is sent until then.",
    "additionalFields": {
     "appendAttribution": false
    }
   },
   "id": "a785e36a-ddfd-4d18-a3b7-e802289d1b86",
   "name": "Send Approval Request via Telegram",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1200,
    0
   ]
  },
  {
   "parameters": {
    "documentId": "YOUR_GOOGLE_SHEET_ID",
    "sheetName": "Approval",
    "operation": "read"
   },
   "id": "f473994e-0ee2-4b97-b1c7-5e4b3384b852",
   "name": "Check Approval Sheet",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4,
   "position": [
    1440,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "f6386d8e-4561-492a-a557-a0404c8467ff",
       "leftValue": "={{ $json.approval || '' }}",
       "rightValue": "APPROVE",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    }
   },
   "id": "f18f03ac-4e47-446b-84f5-d1aa66de2f0f",
   "name": "Approved to Send?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1680,
    0
   ]
  },
  {
   "parameters": {
    "mode": "rules",
    "rules": {
     "values": [
      {
       "value1": "={{ $json.channel || 'email' }}",
       "operation": "equals",
       "value2": "sms"
      },
      {
       "value1": "={{ $json.channel || 'email' }}",
       "operation": "equals",
       "value2": "email"
      }
     ]
    },
    "fallbackOutput": 1
   },
   "id": "0c461ef5-a077-4549-b74c-ac48e8347a7f",
   "name": "Choose Channel (Email or SMS)",
