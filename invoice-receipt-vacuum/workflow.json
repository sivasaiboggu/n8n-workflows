{
  "name": "Invoice and Receipt Vacuum \u2014 Siva",
  "nodes": [
    {
      "parameters": {
        "content": "Gmail (receipt attachments) + webhook photo uploads -> OCR + Gemini extract vendor/date/amount/tax -> categorise -> duplicate check -> HUMAN APPROVAL (Approvals sheet) -> post to accounting sheet / QuickBooks. Nothing posts without Siva marking APPROVED.\nCredentials to set on import (nodes show 'No credential set'): Gmail OAuth2 (Gmail Trigger); Google Sheets OAuth2 (all Sheets nodes); Google Gemini API (chat model); Telegram (approval + error notify); OCR.space API Key via Header Auth (OCR Receipt); QuickBooks OAuth2 via Header Auth (Post to QuickBooks).",
        "height": 120,
        "width": 420
      },
      "id": "88327b5e-85a1-4cd3-812e-0c836a9814b3",
      "name": "Sticky Note \u2014 How this works",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ]
    },
    {
      "parameters": {},
      "id": "12a286d4-8db0-49a8-97eb-5f21c213e674",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "filters": {},
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "id": "0bef889d-c00b-47d3-8c4a-6bad1b93161c",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-upload",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "31a3c901-8181-46e9-a2b2-33e904a0d3bc",
      "name": "Webhook \u2014 Photo Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "7bbdb923-634e-4b1e-be32-7cfecf88c67d",
      "name": "Merge Invoice Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pass through Gmail attachments and webhook binary uploads as one item each.\n// Gmail Trigger items carry attachments in $binary; webhook uploads too.\n// If an item has no binary data it is dropped so OCR never runs on empty input.\nconst out = [];\nfor (const item of $input.all()) {\n  const keys = Object.keys(item.binary || {});\n  if (!keys.length) continue;\n  for (const k of keys) out.push({ json: { source: item.json.from || 'webhook',\n    fileName: item.binary[k].fileName || k, mimeType: item.binary[k].mimeType || '' },\n    binary: { data: item.binary[k] } });\n}\nreturn out;"
      },
      "id": "7290e2ab-5d45-46b7-80e0-f547e42fd6b8",
      "name": "Extract Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ocr.space/parse/image",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        },
        "sendHeaders": true,
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"filetype\": \"{{ $json.mimeType }}\", \"isOverlayRequired\": false, \"scale\": true, \"OCREngine\": \"2\"}"
      },
      "id": "4ea7a084-6707-4ef0-afa6-a287196ab4b9",
      "name": "OCR Receipt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You extract structured invoice data from OCR text. Return ONLY valid JSON with keys: vendor, invoiceDate (YYYY-MM-DD), amount (number), currency, tax (number), category (one of: Software, Travel, Food, Equipment, Services, Other), description. If a field is missing use null \u2014 never invent a value. Siva is Sivasai Boggu, BTech CS IIIT Kottayam, Whispry intern; receipts are his personal / internship expenses."
        },
        "promptType": "define"
      },
      "id": "48898f54-7df1-4c46-9704-42a5cfa4b293",
      "name": "Gemini Extract Invoice",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash",
        "options": {}
      },
      "id": "3d5726b0-c948-4467-8951-b6f7fb113dd2",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        960,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise Gemini output: trim vendor, default currency INR, flag missing fields.\nconst j = $input.first().json;\nconst data = typeof j.output === 'string' ? JSON.parse(j.output) : (j.output || j);\nreturn [{ json: { ...data, currency: data.currency || 'INR',\n  missingReceipt: !data.amount || !data.vendor,\n  extractedAt: new Date().toISOString() } }];"
      },
      "id": "2c3f9d60-ad9f-45a2-bfb2-47fb7096a73e",
      "name": "Categorise Expense",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        240
      ]
    },
    {
      "parameters": {
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "read",
        "options": {},
        "resource": "sheet",
        "sheetName": "Receipts"
      },
      "id": "10ea9ae5-988c-4530-8ab7-9e6cafef58b4",
      "name": "Read Receipts Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1440,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Duplicate = same vendor + same amount + same date already in the Receipts sheet.\nconst items = $input.all(); const cur = items[0].json;\nconst prior = items.slice(1).map(i => i.json);\nconst dup = prior.some(r => String(r.Vendor) === String(cur.vendor)\n  && Number(r.Amount) === Number(cur.amount) && String(r.Date) === String(cur.invoiceDate));\nreturn [{ json: { ...cur, isDuplicate: dup } }];"
      },
      "id": "371a686a-ae7e-459b-88ad-d196e67e0249",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b1aa5972-0722-4aac-adf0-c325ca079bae",
              "leftValue": "={{ $json.isDuplicate }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.string.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      },
      "id": "bc1adb7e-dd86-4a77-94d5-ba4402ace0c1",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        240
      ]
    },
    {
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "Vendor": "={{ $json.vendor }}",
            "Date": "={{ $json.invoiceDate }}",
            "Amount": "={{ $json.amount }}",
            "Currency": "={{ $json.currency }}",
            "Flagged At": "={{ $now.toISO() }}",
            "Reason": "Same vendor + amount + date already in Receipts"
          }
        },
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "operation": "append",
        "resource": "sheet",
        "sheetName": "Duplicates"
      },
      "id": "206a225a-edf3-43e0-abaa-a1a63130777c",
      "name": "Flag Duplicate",
