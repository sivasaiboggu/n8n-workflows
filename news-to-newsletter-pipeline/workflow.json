      "id": "0dd4e2f3-7ceb-5ccc-a9ad-7a94b29c5224",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        960,
        440
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are Siva's newsletter editor. Rank these stories by relevance to Siva's readers (AI agents, software engineering, jobs/tech in India) and summarise the top 5. Stories: {{ JSON.stringify($input.all().map(i => i.json)) }}. Avoid repeating topics already covered (past log is in the input). Return JSON: {\"stories\": [{\"title\": \"\", \"url\": \"\", \"summary\": \"\", \"why_it_matters\": \"\"}]}. Never invent a story or a URL \u2014 use only the URLs given.",
        "options": {
          "systemMessage": "You are helping Siva (Sivasai Boggu). Never invent facts, emails, prices or sources. If you do not know, say so."
        }
      },
      "id": "9cb4e397-0aad-51c8-bb0b-809bd8494805",
      "name": "Rank & Summarise Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Draft in Siva's tone: direct, fast, evidence-led, no hype. Plain text + links.\nconst j = $input.first().json.output || $input.first().json;\nconst stories = j.stories || [];\nlet body = 'Siva\\'s Tech Brief \u2014 ' + new Date().toISOString().slice(0,10) + '\\n\\n';\nstories.forEach((s,i)=>{ body += `${i+1}. ${s.title}\\n${s.summary}\\nWhy it matters: ${s.why_it_matters}\\n${s.url}\\n\\n`; });\nbody += '\u2014 Draft only. Never auto-sent; Siva sends from Beehiiv/Substack with one click.';\nreturn [{json:{subject: 'Tech Brief \u2014 ' + new Date().toISOString().slice(0,10), body, stories}}];"
      },
      "id": "ed25fcdd-0f09-50f3-9f83-1e5eb54ecb2d",
      "name": "Draft Newsletter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.beehiiv.com/v2/publications/YOUR_PUBLICATION_ID/posts",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        },
        "sendHeaders": true,
        "sendBody": true,
        "contentType": "json",
        "body": "= {\"title\": \"{{ $json.subject }}\", \"content\": \"{{ $json.body }}\", \"status\": \"draft\"}"
      },
