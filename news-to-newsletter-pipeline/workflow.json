    {
      "parameters": {
        "jsCode": "// Dedupe by URL, keep title/link/source/published. Drop items with no URL.\nconst seen = new Set(); const out = [];\nfor (const it of $input.all()) { const j = it.json; const items = j.items || j.children || [j];\n for (const x of items) { const url = x.link || x.url || x.data?.url; if (!url || seen.has(url)) continue; seen.add(url);\n  out.push({json:{title: x.title || x.data?.title || '', url, source: x.source || 'rss/hn/reddit', published: x.pubDate || x.created_at_i || ''}}); } }\nreturn out.slice(0, 40);"
      },
      "id": "abac1d68-734e-500d-84ba-efaa56a8b05c",
      "name": "Dedupe & Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "operation": "lookup",
        "documentId": {
