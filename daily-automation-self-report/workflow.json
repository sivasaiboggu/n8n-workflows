        "additionalFields": {}
      },
      "id": "ff054279-8883-468c-a01d-c593c4b8deac",
      "name": "Send Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        600
      ]
    }
  ],
